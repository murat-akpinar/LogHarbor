# Copy to .env (git-ignored) and fill the CHANGE_ME values. systemd reads this file directly
# (EnvironmentFile), so it must stay plain KEY=VALUE with no quotes and no `export`.
LOGHARBOR_URL=http://127.0.0.1:5000

# Ingestion API key. Repo keeps CHANGE_ME; the real key goes in .env only.
LOGHARBOR_API_KEY=CHANGE_ME

# Services to probe: comma-separated kind:name. A bare name means systemd.
#   systemd:<unit>       -> systemctl is-active   (".service" may be omitted)
#   docker:<container>   -> docker inspect        (needs Docker socket access, so usually root)
SERVICES=systemd:docker,systemd:ssh,docker:nginx

# Identity written to the `host` property. Defaults to the machine's hostname; set it when
# the hostname is a container id or otherwise meaningless.
#PROBE_HOST=web-1

# Seconds before a systemctl/docker call is treated as "cannot tell" (never as "down").
#PROBE_COMMAND_TIMEOUT=10

# Admin login — only --setup-alerts needs it (creating signals/alerts is behind the auth gate).
#LOGHARBOR_ADMIN_USER=admin
#LOGHARBOR_ADMIN_PASS=CHANGE_ME
